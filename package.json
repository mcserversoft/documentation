{
  "name": "mcss-docs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run generate:api && next dev --webpack",
    "start": "bun run dev",
    "build": "bun run generate:api && next build --webpack",
    "generate:api": "bun scripts/generate-api.ts",
    "typecheck": "fumadocs-mdx && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "preview": "bun scripts/preview.ts",
    "check:export": "bun scripts/check-export.ts"
  },
  "dependencies": {
    "next": "16.4.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "fumadocs-core": "16.17.3",
    "fumadocs-ui": "16.17.3",
    "fumadocs-mdx": "15.4.7",
    "fumadocs-openapi": "12.4.2",
    "shiki": "^4.0.0",
    "lucide-react": "^0.577.0",
    "yaml": "^2.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.0",
    "@types/bun": "^1.4.3",
    "@types/mdx": "^2.0.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "linkedom": "^0.18.13",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.3.11"
  },
  "packageManager": "bun@1.3.11"
}
